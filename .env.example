
# ============================================================================
# DJANGO SETTINGS
# ============================================================================
SECRET_KEY=your-secret-key-here-generate-new-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Main Enrollment Database (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=program_recommendation_db
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=5432

# LIS Database (READ-ONLY PostgreSQL)
LIS_DB_NAME=lis_db
LIS_DB_USER=postgres
LIS_DB_PASSWORD=your_database_password
LIS_DB_HOST=localhost
LIS_DB_PORT=5432

# ============================================================================
# GOOGLE CLOUD CONFIGURATION
# ============================================================================
# Google Cloud Project
GOOGLE_CLOUD_PROJECT=your-project-id
GCP_PROJECT_ID=your-project-id

# Document AI Configuration
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
DOCUMENT_AI_LOCATION=us

# Path to Google Service Account JSON file
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# ============================================================================
# GEMINI API CONFIGURATION
# ============================================================================
# Gemini API Key (for OCR with Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# Note: Get your API key from https://makersuite.google.com/app/apikey

# ============================================================================
# GOOGLE SERVICE ACCOUNT CREDENTIALS (JSON Format)
# ============================================================================
GCP_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GCP_CLIENT_ID=your-client-id
GCP_PROJECT_NUMBER=your-project-number

# ============================================================================
# OCR CONFIGURATION
# ============================================================================
OCR_TOLERANCE=3.0
OCR_USE_DOCUMENT_AI=True
OCR_ASYNC_PROCESSING=False
OCR_BATCH_SIZE=10
OCR_SUBJECT_TOLERANCE=0.70
OCR_ROW_Y_PADDING=35
OCR_COLUMN_PAD=50

# ============================================================================
# CELERY CONFIGURATION (Optional - For Async Tasks)
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password

# ============================================================================
# MACHINE LEARNING MODEL PATHS
# ============================================================================
ML_MODEL_DIR=TRAINING_ARC/models
ML_SCALER_PATH=TRAINING_ARC/models/scaler.pkl
ML_MODEL_PATH=TRAINING_ARC/models/best_model.pkl

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_UPLOAD_EXTENSIONS=pdf,jpg,jpeg,png

# ============================================================================
# SECURITY SETTINGS (Production)
# ============================================================================
# Uncomment these for production deployment
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

# ============================================================================
# TIMEZONE SETTINGS
# ============================================================================
TIME_ZONE=Asia/Manila
USE_TZ=True

# ============================================================================
# STATIC & MEDIA FILES
# ============================================================================
STATIC_URL=/static/
MEDIA_URL=/media/
MEDIA_ROOT=media/

# ============================================================================
# LOGGING LEVEL
# ============================================================================
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 1. Copy this file to .env in the project root
# 2. Replace all placeholder values with your actual credentials
# 3. For SECRET_KEY, generate a new one using:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 4. Download your Google Cloud service account JSON file and update GOOGLE_APPLICATION_CREDENTIALS path
# 5. Get your Gemini API key from https://makersuite.google.com/app/apikey
# 6. Update database credentials to match your local setup
# 7. Never commit the .env file to git
# ============================================================================
